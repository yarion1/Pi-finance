# Copie para /etc/financas/.env (sudo) e troque os valores.
# sudo chown root:docker /etc/financas/.env && sudo chmod 640 /etc/financas/.env

# Postgres: dono do banco (migrações e backup) e papel do app (sem acesso fora do RLS)
POSTGRES_PASSWORD=troque-por-uma-senha-longa
APP_DB_PASSWORD=troque-por-outra-senha-longa

# URL pela qual o navegador abre o painel (passkeys e a checagem de origem dependem dela)
PUBLIC_URL=https://pi.SEU-TAILNET.ts.net:8443

# Avisos de deploy: pelo PiControl (preferido) ou direto no Telegram
PICONTROL_URL=http://127.0.0.1:9090
PICONTROL_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude (fase 6)
ANTHROPIC_API_KEY=
